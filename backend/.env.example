# ==============================================================================
# CONNECT ADMIN PORTAL - BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
OTP_PEPPER_SECRET=your_otp_pepper_secret_here
OTP_EXPIRES_MINUTES=2

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Redis Real-Time Event Broker & Cache
REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Mail Dispatch Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Cross-Origin Resource Sharing (CORS) & Client Domains
ADMIN_FRONTEND_URL=http://localhost:5173
FRONTEND_URL=https://your-admin-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:3001
